<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="TrayRadar.Views.RadarFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="using:WinUIEx"
    xmlns:map="using:WinUIEx.Maps"
    Title="Tray Radar">

    <ex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </ex:WindowEx.SystemBackdrop>

    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>

        <map:MapControl
            x:Name="Map"
            AutomationProperties.Name="Weather radar map"
            MapStyle="Road" />

        <StackPanel Margin="8" VerticalAlignment="Top" Spacing="6">
            <!--  Toolbar  -->
            <Border
                Padding="12,4,4,4"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            x:Name="LiveDot"
                            Width="8"
                            Height="8"
                            Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock
                            x:Name="FrameTimeText"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Radar" />
                    </StackPanel>

                    <Button
                        x:Name="PlayButton"
                        Grid.Column="1"
                        AutomationProperties.Name="Play radar loop"
                        Click="PlayButton_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="Play loop">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Go to default view"
                        Click="RecenterButton_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="Go to default view">
                        <FontIcon Glyph="&#xE80F;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        AutomationProperties.Name="Save current view as default"
                        Click="SaveViewButton_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="Save this view as default">
                        <FontIcon x:Name="SaveViewIcon" Glyph="&#xE718;" />
                    </Button>
                    <Button
                        Grid.Column="4"
                        AutomationProperties.Name="Settings"
                        Click="SettingsButton_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon Glyph="&#xE713;" />
                    </Button>
                </Grid>
            </Border>

            <!--  Frame scrubber: shown while the loop plays or a past frame is selected  -->
            <Border
                x:Name="FrameScrubber"
                Padding="12,0,4,0"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider
                        x:Name="FrameSlider"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Radar frame"
                        IsThumbToolTipEnabled="False"
                        Minimum="0"
                        SnapsTo="StepValues"
                        StepFrequency="1"
                        TickFrequency="1"
                        TickPlacement="Inline"
                        ValueChanged="FrameSlider_ValueChanged" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Stop loop and hide frame slider"
                        Click="HideScrubberButton_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="Stop loop and hide frame slider">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</ex:WindowEx>
